#########################################
# APPLICATION
#########################################

NODE_ENV=production
APP_NAME=CRM for HRMS
APP_VERSION=1.0.0

API_PREFIX=/api
API_VERSION=v1

HOST=127.0.0.1
PORT=5000

#########################################
# DATABASE
#########################################

DB_HOST=192.168.60.146
DB_PORT=5432
DB_NAME=crm_hrms
DB_USER=crmuser
DB_PASSWORD=StrongPassword

DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_SLOW_QUERY_THRESHOLD=500
DB_CONNECTION_RETRIES=5
DB_CONNECTION_RETRY_DELAY=2000

#########################################
# JWT
#########################################

JWT_SECRET=8752da18e66edf2f6a36185c91fb6cd1

JWT_EXPIRES_IN=1d

JWT_REFRESH_EXPIRES_IN=7d

#########################################
# LOGGING
#########################################

LOG_LEVEL=debug

LOG_MAX_SIZE=20m

LOG_MAX_FILES=30d

LOG_ZIPPED_ARCHIVE=true

LOG_DIRECTORY=/var/log/crm-hrms



#########################################
# SECURITY
#########################################

BCRYPT_SALT_ROUNDS=12

CORS_ALLOWED_ORIGINS=https://gad-hrms-grievance-webapp.bsdc.gov.in
CORS_CREDENTIALS=true

RATE_LIMIT_WINDOW=10

RATE_LIMIT_MAX_REQUESTS=1000

RATE_LIMIT_AUTH_WINDOW=15
RATE_LIMIT_AUTH_MAX_REQUESTS=100

TRUST_PROXY=1

#########################################
# FEATURES
#########################################

ENABLE_SWAGGER=false

ENABLE_REQUEST_LOGGING=true



COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1kb

REQUEST_BODY_SIZE=1mb
PARAMETER_LIMIT=1000

COOKIE_SECRET=cb9dfa8003b05ccd02f1aa5e7fc01fe3fdf46d40d8ee16818dc0de2111211830c5f457adbe5c386d1231bab7eb50d5f5ba303b56ed56fc35ba3b26c5fd5f8bf1

##########################################
# SEEDERS
##########################################

SEED_ADMIN_USERNAME=developer
SEED_ADMIN_EMAIL=developer@hrms.com
SEED_ADMIN_PASSWORD=Developer@123

TICKET_ATTACHMENT_STORAGE_PATH=/var/lib/crm-hrms/ticket-attachments